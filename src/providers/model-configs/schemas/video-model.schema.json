{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Video model configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "../../schemas/video-model.schema.json"
    },
    "configId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["text", "first-frame", "first-last-frame", "reference"]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "aspectRatios": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:adaptive|[1-9][0-9]*(?:\\.[0-9]+)?:[1-9][0-9]*(?:\\.[0-9]+)?)$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "minDurationSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "maxDurationSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "supportsAutoDuration": {
      "type": "boolean"
    },
    "supportsAudio": {
      "type": "boolean"
    },
    "requiresAutoVideoReferenceParams": {
      "type": "boolean"
    },
    "requiresAdaptiveFrameRatio": {
      "type": "boolean"
    },
    "maxReferenceImages": {
      "type": "integer",
      "minimum": 0
    },
    "maxReferenceVideos": {
      "type": "integer",
      "minimum": 0
    },
    "maxReferenceAudios": {
      "type": "integer",
      "minimum": 0
    },
    "maxReferenceDurationSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "supportsAudioOnlyReference": {
      "type": "boolean"
    }
  },
  "required": [
    "$schema",
    "configId",
    "displayName",
    "modes",
    "resolutions",
    "aspectRatios",
    "minDurationSeconds",
    "maxDurationSeconds",
    "supportsAutoDuration",
    "supportsAudio",
    "requiresAdaptiveFrameRatio"
  ],
  "additionalProperties": false
}
