{
  "$schema": "../../schemas/image-model.schema.json",
  "configId": "openai/gpt-image-1.5",
  "displayName": "GPT Image 1.5 / 1 / Mini",
  "aspectRatios": ["1:1", "3:2", "2:3"],
  "imageDimensions": {
    "1:1": {
      "width": 1024,
      "height": 1024
    },
    "3:2": {
      "width": 1536,
      "height": 1024
    },
    "2:3": {
      "width": 1024,
      "height": 1536
    }
  },
  "backgrounds": ["opaque", "transparent"],
  "qualities": ["auto", "low", "medium", "high"],
  "outputFormats": ["png", "jpeg", "webp"],
  "maxImagesPerRequest": 4,
  "supportsReferenceImages": true,
  "maxReferenceImages": 16
}
