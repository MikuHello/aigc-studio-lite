{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aigc-studio-lite",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "PROXY_ALLOWED_BASE_URLS": [],
  },
  // @reason 调用日志包含请求事件；认证头默认脱敏由 Cloudflare 提供，不覆盖应用主动输出，边界见 docs/deployment.md#代理凭据与日志。
  "observability": {
    "enabled": true,
  },
}
